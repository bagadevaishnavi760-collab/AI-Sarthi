# Frontend-to-backend URL (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Optional: configure only when using the existing prediction endpoints.
# Prediction and history endpoints return 503 when this is unset.
DATABASE_URL=

# Local RAG runtime. These models run on this machine; no hosted model API is used.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional local model cache directory; blank uses the Hugging Face default cache.
RAG_MODEL_CACHE_DIR=

# Paths are relative to the repository root unless absolute.
RAG_DATA_DIR=data/rag
RAG_DOCUMENTS_DIR=data/rag/documents
RAG_INDEX_DIR=data/rag/faiss_index
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_RETRIEVAL_K=5
# LangChain FAISS returns squared L2 distance for this IndexFlatL2 store.
RAG_MAX_SQUARED_L2_DISTANCE=1.3

# Optional paths to datasets; defaults search repository root and data/cleaned.
# NHM_BUDGET_CSV=
# INFRASTRUCTURE_CSV=
# HMIS_CSV=

# Explicit local Vite origins only; do not add wildcard origins with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
